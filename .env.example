# Postgres connection string. Locally: start a dev database with `npx prisma dev --name campusnest`,
# then copy the TCP URL from `npx prisma dev ls`. On Vercel this is set by the Neon integration.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
# Only needed locally for `prisma migrate dev` against the Prisma dev server
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"
# Optional: public URL of the site for share images (defaults to the Vercel production URL)
# NEXT_PUBLIC_SITE_URL="https://campusnest.example.com"

# ─── Accounts (Better Auth) ───
# Signs sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me"
# Public URL of the site (defaults to NEXT_PUBLIC_SITE_URL / the Vercel production URL / localhost)
# BETTER_AUTH_URL="http://localhost:3000"

# Google sign-in (optional — the button is hidden when unset). Google Cloud Console → Credentials →
# OAuth client ID (Web). Redirect URI: <site URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email sign-in links via Resend (https://resend.com). Unset locally: links are printed in the terminal.
RESEND_API_KEY=""
# Sender, from a domain verified in Resend. Default onboarding@resend.dev only delivers to your own address.
# EMAIL_FROM="CampusNest <hello@yourdomain.com>"

# Team members who can open /admin and download leads as Excel (comma-separated)
ADMIN_EMAILS="you@example.com"
